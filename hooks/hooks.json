{
  "description": "kerjaan — dispatch the reviewer agent when a ticket enters review, remind the foreman when a worker that moved its ticket there has finished, and have the foreman write a handoff before its context is summarized and read it right after",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/on-ticket-review.sh\"",
            "if": "Bash(*update-ticket.sh*)",
            "timeout": 10,
            "statusMessage": "Checking for a ticket entering review"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/on-ticket-review.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/handoff.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/on-ticket-review.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/handoff.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/kerjaan/scripts/handoff.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
